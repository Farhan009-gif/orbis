<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The whole app (index.html) is bundled in assets and loaded from
         there. INTERNET is the one permission declared: it lets the
         OrbisNet bridge (see MainActivity.kt) make native API calls for
         the Assistant's user-configured endpoints — native HTTP is not
         bound by the CORS rules that block WebView fetch() calls.
         Without saved API settings the app still works fully offline. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbis">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Orbis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
